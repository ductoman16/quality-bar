{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "erasableSyntaxOnly": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.mts",
    "test/**/*.ts",
    "ui/**/*.ts",
    "scripts/**/*.mts"
  ]
}
